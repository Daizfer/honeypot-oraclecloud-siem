@startuml
' ============ RENDER SETTINGS (para que no se pise nada) ============
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam Padding 10
skinparam RectanglePadding 14
skinparam roundCorner 12
skinparam ArrowThickness 1.2
skinparam ArrowColor #333333
skinparam RectangleBorderColor #333333
skinparam RectangleFontColor #111111
skinparam NoteBorderColor #CC7A00
skinparam NoteBackgroundColor #FFF2CC

left to right direction
title Cloud Honeypot – WireGuard – SIEM (OCI ARM64 – Zero Trust)

' ======================= EXTERNAL =======================
cloud "INTERNET" as NET
rectangle "Admin User\n(Laptop)" as ADMIN

' ======================= OCI / NETWORK =======================
rectangle "Oracle Cloud Infrastructure (OCI)\nAlways Free Tier – ARM64 (Ampere A1)\nVCN: 10.0.1.0/24   Subnet: 10.0.1.0/24" as OCI {

  package "Public Instances (2x Public IP)" as PUB {

    rectangle "SENSOR – Honeypots (Public)\nOS: Oracle Linux 9 (ARM64)\nPrivate IP: 10.0.1.37\nPublic IP: x.x.x.x\n\nExposed (ATTACK) services:\n- 22/TCP  Cowrie (SSH honeypot)\n- 80/TCP  DVWA (Web honeypot)\n\nAdmin (REAL SSH):\n- 2222/TCP  (ONLY via VPN)\n\nTelemetry:\n- Wazuh Agent\n- Docker: Cowrie + DVWA" as SENSOR

    rectangle "WIREGUARD – VPN Gateway (Public)\nOS: Ubuntu 24.04 LTS (ARM64)\nPrivate IP: 10.0.1.40\nPublic IP: x.x.x.x\n\nVPN entry:\n- 51820/UDP (WireGuard)\n\nRole:\n- Single admin entry point\n- Private access to SENSOR & SIEM" as WG
  }

  package "Private Instance (NO Public IP)" as PRIV {
    rectangle "SIEM – Wazuh Manager (Private)\nOS: Ubuntu 24.04 LTS (ARM64)\nPrivate IP: 10.0.1.38\nPublic IP: NONE\n\nComponents:\n- Wazuh Manager\n- Wazuh Dashboard\n\nReceives logs:\n- 1514/TCP (Wazuh)\n\nSecurity:\n- Not exposed to Internet\n- Access only via VPN / private network" as SIEM
  }
}

' ======================= FLOWS (claros y separados) =======================
' Attack surface
NET --> SENSOR : Attack traffic\n22/TCP (Cowrie)\n80/TCP (DVWA)
NET --> WG : VPN entry\n51820/UDP

' Telemetry / logs
SENSOR --> SIEM : Log forwarding (private)\n1514/TCP

' Admin path (Zero Trust)
ADMIN --> WG : WireGuard tunnel\n51820/UDP
WG --> SENSOR : Admin SSH (private)\n2222/TCP (VPN-only)
WG --> SIEM : Dashboard access (private)\n(via VPN)

' ======================= NOTES (detalle extra) =======================
note right of SENSOR
Hardening:
- Real SSH moved to 2222
- Honeypot uses 22
- 2222 reachable ONLY from VPN
end note

note bottom of SIEM
Zero Trust principles:
- SIEM isolated from Internet
- Least privilege in OCI rules
- Segmented architecture (public vs private)
end note

@enduml
