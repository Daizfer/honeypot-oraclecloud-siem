@startuml
' ============ RENDER SETTINGS (portfolio clean) ============
skinparam backgroundColor white
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam Padding 10
skinparam RectanglePadding 14
skinparam roundCorner 12

skinparam ArrowThickness 1.3
skinparam ArrowColor #333333
skinparam RectangleBorderColor #333333
skinparam RectangleFontColor #111111

skinparam NoteBorderColor #CC7A00
skinparam NoteBackgroundColor #FFF2CC

' Improve routing (less crossing / cleaner)
skinparam linetype ortho
skinparam nodesep 45
skinparam ranksep 55

left to right direction
title Cloud Honeypot – WireGuard – SIEM (OCI ARM64 – Zero Trust)

' ======================= EXTERNAL =======================
cloud "INTERNET" as NET
rectangle "Admin User\n(Laptop)" as ADMIN

' ======================= OCI / NETWORK =======================
rectangle "Oracle Cloud Infrastructure (OCI)\nAlways Free Tier – ARM64 (Ampere A1)\nVCN: 10.0.1.0/24   Subnet: 10.0.1.0/24" as OCI {

  package "Public Instances (2x Public IP)" as PUB {

    rectangle "SENSOR – Honeypots (Public)\nOS: Oracle Linux 9 (ARM64)\nPrivate IP: 10.0.1.37\nPublic IP: x.x.x.x\n\nExposed (ATTACK) services:\n- 22/TCP  Cowrie (SSH honeypot)\n- 80/TCP  DVWA (Web honeypot)\n\nAdmin (REAL SSH):\n- 2222/TCP  (VPN-only)\n\nTelemetry:\n- Wazuh Agent\n- Docker: Cowrie + DVWA" as SENSOR

    rectangle "WIREGUARD – VPN Gateway (Public)\nOS: Ubuntu 24.04 LTS (ARM64)\nPrivate IP: 10.0.1.40\nPublic IP: x.x.x.x\n\nVPN entry:\n- 51820/UDP (WireGuard)\n\nRole:\n- Single admin entry point\n- Private access to SENSOR & SIEM" as WG

    ' Anchor layout (keeps both in same band)
    SENSOR -[hidden]-> WG
  }

  package "Private Instance (NO Public IP)" as PRIV {
    rectangle "SIEM – Wazuh Manager (Private)\nOS: Ubuntu 24.04 LTS (ARM64)\nPrivate IP: 10.0.1.38\nPublic IP: NONE\n\nComponents:\n- Wazuh Manager\n- Wazuh Dashboard\n\nReceives logs:\n- 1514/TCP (Wazuh)\n\nSecurity:\n- No Internet exposure\n- Private-only access via VPN" as SIEM
  }

  ' Anchor SIEM below
  WG -[hidden]-> SIEM
  SENSOR -[hidden]-> SIEM
}

' ======================= FLOWS (color-coded) =======================
' RED = Public exposure / attack surface
NET -[#C0392B]-> SENSOR : Attack traffic (Public)\n22/TCP (Cowrie)\n80/TCP (DVWA)
NET -[#C0392B]-> WG     : VPN entry (Public)\n51820/UDP

' BLUE = Internal log forwarding
SENSOR -[#1F77B4]-> SIEM : Log forwarding (Private)\n1514/TCP (Wazuh)

' GREEN = Admin via VPN (private access after tunnel)
ADMIN -[#2CA02C]-> WG     : WireGuard tunnel\n51820/UDP
WG    -[#2CA02C]-> SENSOR : Admin SSH (Private)\n2222/TCP (VPN-only)
WG    -[#2CA02C]-> SIEM   : Dashboard (Private)\n(via VPN)

' ======================= NOTES (detalle extra) =======================
note right of SENSOR
Hardening:
- Port 22 is honeypot (Cowrie)
- Real SSH moved to 2222
- 2222 reachable ONLY through VPN
end note

note bottom of SIEM
Zero Trust:
- SIEM has NO public IP
- No inbound from Internet
- Least privilege rules in OCI
end note

legend right
<color:#C0392B>Red</color>   = Public exposure (attack/VPN entry)
<color:#1F77B4>Blue</color>  = Private log forwarding to SIEM
<color:#2CA02C>Green</color> = Admin access via VPN (private)
endlegend

@enduml
